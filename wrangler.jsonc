{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cupline",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "cupline.jaeaeich.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "404-page",
    "run_worker_first": ["/agents/*", "/admin/*"]
  },
  "ai": { "binding": "AI", "remote": true },
  "durable_objects": {
    "bindings": [{ "name": "StringAgent", "class_name": "StringAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StringAgent"] }],
  "ratelimits": [{ "name": "TURN_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  "observability": { "enabled": true }
}
